# Normalise line endings: LF in the repository, native in the working copy.
* text=auto eol=lf

# Binary files git must not touch.
*.png binary
*.jpg binary
*.gif binary
*.zip binary
*.mo  binary

# Exclude repo-only files from GitHub's release archives.
/.gitattributes export-ignore
/.gitignore     export-ignore
/.editorconfig  export-ignore
