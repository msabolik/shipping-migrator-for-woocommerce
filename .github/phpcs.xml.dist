<?xml version="1.0"?>
<!-- WordPress Coding Standards for this repository, checked by .github/wpcs.sh (CI runs it in the Lint workflow). -->
<ruleset name="shipping-migrator-for-woocommerce">
	<file>..</file>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<!-- Generated by `wp i18n make-php` from the .po file: not code anyone edits. -->
	<exclude-pattern>*.l10n.php</exclude-pattern>
	<arg name="extensions" value="php"/>
	<arg name="basepath" value=".."/>
	<arg name="parallel" value="8"/>

	<!-- The plugin header's "Requires at least": older functions count as deprecated from here on. Change both together. -->
	<config name="minimum_wp_version" value="6.0"/>

	<!-- WordPress-Core plus the extra best-practice and security sniffs. -->
	<rule ref="WordPress-Extra"/>

	<!-- WooCommerce's capability for managing the store (WooCommerce registers it). -->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_woocommerce"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="shipping-migrator-for-woocommerce"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="smfw"/>
			</property>
		</properties>
	</rule>
</ruleset>
