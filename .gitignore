# --- Operating system --------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# --- Editors and IDEs --------------------------------------------------------
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.phpstorm.meta.php
_ide_helper.php

# --- Dependencies ------------------------------------------------------------
node_modules/
vendor/
composer.lock
package-lock.json
yarn.lock

# --- Build artefacts ---------------------------------------------------------
build/
dist/
*.zip
*.tar.gz

# --- Secrets and local config ------------------------------------------------
# Nothing in this plugin needs credentials, but these patterns stop a stray
# local config or key from ever being committed by accident.
.env
.env.*
*.pem
*.key
*.p12
auth.json
wp-config.php
config.local.php

# --- Logs and dumps ----------------------------------------------------------
*.log
debug.log
error_log
*.sql
*.sql.gz

# --- Test and tooling output -------------------------------------------------
.phpunit.result.cache
.phpcs-cache
coverage/
tests/_output/

# --- Export files ------------------------------------------------------------
# Exports contain a store's real shipping configuration and its source URL.
# Never commit one.
wc-shipping-export-*.json
